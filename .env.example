# 브라우저에서 Kakao 지도 SDK를 불러오는 공개 JavaScript 키입니다.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# CSV 수집 시 좌표 캐시에 없는 주소만 변환하는 서버 전용 REST 키입니다.
# NEXT_PUBLIC_ 접두사를 붙이거나 저장소에 커밋하지 마세요.
KAKAO_REST_API_KEY=

# 선택 사항: 검수용 API 수집 명령에서만 사용합니다.
PUBLIC_DATA_PORTAL_SERVICE_KEY=

# Vercel Marketplace Neon이 주입하는 서버 전용 연결 문자열입니다.
# 둘 중 하나만 설정합니다. 브라우저 공개용 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
DATABASE_URL=
POSTGRES_URL=

# /admin/analytics HTTP Basic 인증과 일별 보관 정리에 사용하는 서버 전용 값입니다.
ANALYTICS_ADMIN_USERNAME=
ANALYTICS_ADMIN_PASSWORD=
# 익명 방문자 ID를 DB에 저장하지 않고 HMAC 처리하는 32자 이상의 서버 전용 비밀값입니다.
ANALYTICS_VISITOR_HASH_SECRET=
CRON_SECRET=
